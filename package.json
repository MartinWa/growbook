{
  "name": "growbook-frontend",
  "private": true,
  "description": "Pinned Tailwind CSS and daisyUI build for the server-rendered Django interface.",
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build:css": "tailwindcss -i assets/app.css -o static/css/app.css --minify",
    "watch:css": "tailwindcss -i assets/app.css -o static/css/app.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.4",
    "daisyui": "5.7.50",
    "tailwindcss": "4.3.4"
  }
}