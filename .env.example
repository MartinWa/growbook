# Copy to untracked .env only for a private server. Replace every placeholder.
GROWBOOK_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_50_CHARACTERS_LONG
GROWBOOK_ALLOWED_HOSTS=garden.example.internal
GROWBOOK_CSRF_TRUSTED_ORIGINS=https://garden.example.internal
GROWBOOK_TIME_ZONE=Europe/Stockholm
# Check public stable releases through the server; set false for offline installations.
GROWBOOK_UPDATE_CHECK=true
# Apply pending schema migrations when the server starts (recommended for one container).
GROWBOOK_MIGRATE_ON_START=true
# Set true behind a trusted HTTPS reverse proxy that replaces X-Forwarded-Proto.
# Keep the application port private and restrict access to trusted proxy/network peers.
GROWBOOK_TRUST_PROXY=false
APP_UID=1000
APP_GID=1000
APP_DATA_PATH=/path/to/private/host-local/growbook-data
PROXY_NETWORK=replace-with-private-proxy-network
