{
  "name": "Growbook Linux",
  "dockerComposeFile": "../compose.development.yaml",
  "service": "app",
  "workspaceFolder": "/app",
  "remoteUser": "developer",
  "updateRemoteUserUID": false,
  "overrideCommand": false,
  "shutdownAction": "stopCompose",
  "postStartCommand": "python tools/check_development.py",
  "waitFor": "postStartCommand",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.debugpy", "charliermarsh.ruff"],
      "settings": {
        "python.defaultInterpreterPath": "/state/venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["tests"],
        "python.testing.cwd": "/app"
      }
    }
  }
}
