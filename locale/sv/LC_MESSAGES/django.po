msgid_plural "%(count)s observations"
msgstr[0] "%(count)s observation"
msgstr[1] "%(count)s observationer"

msgid "Garden navigation"
msgstr "Trädgårdsmeny"

msgid "Plants you grow."
msgstr "Växter du odlar."

msgid "Named varieties of a crop."
msgstr "Namngivna sorter av en gröda."

msgid "Beds, pots and other places."
msgstr "Bäddar, krukor och andra platser."

msgid "Active records"
msgstr "Aktiva poster"

msgid "Plan and follow your plantings"
msgstr "Planera och följ dina odlingar"

msgid "Only crop and start year are required."
msgstr "Bara gröda och startår behöver anges."

msgid "More details"
msgstr "Fler detaljer"

msgid "Notes and photos"
msgstr "Anteckningar och bilder"

msgid "Clear the end year for an annual planting, or choose Persistent."
msgstr "Ta bort slutåret för en ettårig odling, eller välj Flerårig."

msgid "Planting filters"
msgstr "Filtrera odlingar"

msgid "Archive options"
msgstr "Arkivinställningar"

msgid "Showing archived records"
msgstr "Arkiverade poster visas"

msgid "Hide archived records"
msgstr "Dölj arkiverade poster"

msgid "Batch"
msgstr "Omgång"

msgid "The photo limit is exceeded. Remove selected photos before saving."
msgstr "Bildgränsen har överskridits. Ta bort valda bilder innan du sparar."

msgid "Clear selected photos"
msgstr "Rensa valda bilder"

msgid "%(count)s planting"
msgid_plural "%(count)s plantings"
msgstr[0] "%(count)s odling"
msgstr[1] "%(count)s odlingar"

msgid "Photos selected: {selected}"
msgstr "Valda bilder: {selected}"

msgid "No crops yet"
msgstr "Inga grödor ännu"

msgid "No varieties yet"
msgstr "Inga sorter ännu"

msgid "No growing areas yet"
msgstr "Inga odlingsplatser ännu"

msgid "Add a crop to organize varieties and start planning plantings."
msgstr "Lägg till en gröda för att samla sorter och börja planera odlingar."

msgid "Add a variety to a crop when you want to record more detail."
msgstr "Lägg till en sort till en gröda när du vill spara mer information."

msgid "Add a growing area to record where you grow and link observations."
msgstr "Lägg till en odlingsplats för att ange var du odlar och koppla observationer."

msgid "No active records"
msgstr "Inga aktiva poster"

msgid "Your archived records are available in the archive view."
msgstr "Dina arkiverade poster finns i arkivvyn."

msgid "Show archived records"
msgstr "Visa arkiverade poster"

msgid "Add a crop first, then record its varieties."
msgstr "Lägg först till en gröda och sedan dess sorter."

msgid "No plantings yet"
msgstr "Inga odlingar ännu"

msgid "Start a planting with a crop and growing year; add details later."
msgstr "Börja en odling med en gröda och ett odlingsår. Lägg till detaljer senare."

msgid "No plantings in this growing year"
msgstr "Inga odlingar detta odlingsår"

msgid "Clear the filters to see the planting history."
msgstr "Rensa filtren för att se odlingshistoriken."

msgid "See all years to find earlier plans and ongoing plantings."
msgstr "Visa alla år för att hitta tidigare planer och pågående odlingar."

msgid "Add a crop first, then plan where and when to grow it."
msgstr "Lägg först till en gröda och planera sedan var och när du ska odla den."
